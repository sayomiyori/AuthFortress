# Copy to ".env" in this folder (Docker Compose and Pydantic load it).
# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL must match OAUTH_REDIRECT_BASE_URL + /api/v1/oauth/github/callback

# Required: generate a unique random secret with at least 32 bytes.
JWT_SECRET_KEY=

# Optional: enables the internal tenant-status endpoint for WebHook Manager.
# Generate an independent random ASCII secret of 32 to 256 bytes; never reuse JWT_SECRET_KEY.
# AUTHFORTRESS_WEBHOOK_SERVICE_KEY=

OAUTH_REDIRECT_BASE_URL=http://localhost:28080

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Optional Fernet key (44 chars). If empty, derived from JWT_SECRET_KEY.
# OAUTH_TOKEN_ENCRYPTION_KEY=

# Test-only variables: export them in the shell before pytest (see README).
# Use the disposable verification PostgreSQL database and Redis database 15.
# TEST_DATABASE_URL=postgresql+psycopg2://TEST_USER:TEST_PASSWORD@localhost:55432/authfortress_pytest_test
# TEST_REDIS_URL=redis://localhost:56379/15
